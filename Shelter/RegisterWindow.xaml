<Window x:Class="AppliedProgramming.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AppliedProgramming"
        Style="{DynamicResource AppWindow}"
        Title="Регистрация — «В добрые руки»" Width="460" Height="700"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Panel}" Margin="20" Padding="24">
            <StackPanel>
                <TextBlock Text="Регистрация пользователя" Style="{StaticResource Title}" Margin="0,0,0,10"/>

                <Label Content="ФИО" Style="{DynamicResource FormLabel}"/>
                <TextBox x:Name="tbName" local:Input.Mode="Letters" MaxLength="80"
                         ToolTip="Фамилия, имя и отчество. Цифры вводить нельзя"/>

                <Label Content="Номер телефона" Style="{DynamicResource FormLabel}"/>
                <TextBox x:Name="tbPhone" local:Input.Mode="Phone" MaxLength="16"
                         ToolTip="Только цифры и знак «-»"/>

                <Label Content="Логин" Style="{DynamicResource FormLabel}"/>
                <TextBox x:Name="tbLogin" Style="{StaticResource ValidatedTextBox}" MaxLength="30"
                         ToolTip="Латинские буквы, цифры, «_»; не менее 5 символов"/>

                <Label Content="Пароль" Style="{DynamicResource FormLabel}"/>
                <PasswordBox x:Name="pbPass" MaxLength="30" PasswordChanged="pbPass_PasswordChanged"
                             ToolTip="Не менее 5 символов"/>

                <Label Content="Роль в системе" Style="{DynamicResource FormLabel}"/>
                <ComboBox x:Name="cbRole" ToolTip="Выберите роль пользователя">
                    <ComboBoxItem Content="Администратор"/>
                    <ComboBoxItem Content="Волонтёр"/>
                    <ComboBoxItem Content="Ветеринарный врач"/>
                </ComboBox>

                <Button Content="Зарегистрироваться" Margin="4,12,4,4" Click="btnRegister_Click"/>
                <Button Content="Назад" HorizontalAlignment="Left" Click="btnBack_Click" ToolTip="Shift + 1"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
