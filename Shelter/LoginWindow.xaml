<Window x:Class="AppliedProgramming.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AppliedProgramming"
        Style="{DynamicResource AppWindow}"
        Title="Авторизация — «В добрые руки»" Width="460" Height="680"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Border Style="{StaticResource Panel}" VerticalAlignment="Center" Padding="24">
            <StackPanel>
                <!-- ПР №8: кисть LinearGradientBrush - локальный ресурс текстового поля -->
                <TextBox Text="В добрые руки" IsReadOnly="True" Focusable="False"
                         FontSize="30" FontWeight="Bold" HorizontalContentAlignment="Center"
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,2">
                    <TextBox.Resources>
                        <LinearGradientBrush x:Key="TitleGradient" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF2F6BFF" Offset="0"/>
                            <GradientStop Color="#FF9B51E0" Offset="0.5"/>
                            <GradientStop Color="#FFE52E71" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBox.Resources>
                    <TextBox.Foreground>
                        <StaticResource ResourceKey="TitleGradient"/>
                    </TextBox.Foreground>
                </TextBox>
                <TextBlock Text="Система учёта приюта для животных" Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <Label Content="Логин" Style="{DynamicResource FormLabel}"/>
                <TextBox x:Name="tbLogin" Style="{StaticResource ValidatedTextBox}" MaxLength="30"
                         ToolTip="Введите логин: латинские буквы, цифры или «_», не менее 5 символов"/>

                <Label Content="Пароль" Style="{DynamicResource FormLabel}"/>
                <PasswordBox x:Name="pbPass" MaxLength="30" PasswordChanged="pbPass_PasswordChanged"
                             ToolTip="Введите пароль (не менее 5 символов)"/>

                <TextBlock x:Name="tbInfo" Foreground="#FFD64545" TextWrapping="Wrap"
                           MinHeight="20" Margin="0,0,0,6" HorizontalAlignment="Center"/>

                <Button x:Name="btnLogin" Content="Войти" Click="btnLogin_Click"/>
                <UniformGrid Columns="2">
                    <Button x:Name="btnClient" Content="Войти как клиент" Click="btnClient_Click"
                            ToolTip="Клиентам авторизация не требуется"/>
                    <Button x:Name="btnRegister" Content="Регистрация" Click="btnRegister_Click"/>
                </UniformGrid>

                <Grid Margin="0,10,0,0">
                    <Button Content="Назад" HorizontalAlignment="Left" Click="btnBack_Click"
                            ToolTip="Shift + 1"/>
                    <Button x:Name="btnTheme" HorizontalAlignment="Right" Click="btnTheme_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
