<Window x:Class="AppliedProgramming.AdoptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AppliedProgramming"
        Style="{DynamicResource AppWindow}"
        Title="Выдача питомца в семью" Width="520" Height="620" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Триггер данных: кнопка неактивна, пока не отмечен договор -->
        <Style x:Key="ConfirmButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=chContract, Path=IsChecked}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Выдача питомца" Style="{StaticResource Title}" VerticalAlignment="Center"/>
            <local:UserBar x:Name="userBar" HorizontalAlignment="Right"/>
        </Grid>
        <Button DockPanel.Dock="Bottom" Content="Назад" HorizontalAlignment="Left" Margin="0,10,0,0"
                Click="btnBack_Click" ToolTip="Shift + 1"/>
        <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
            <StackPanel>
                <Label Content="Питомец" Style="{DynamicResource FormLabel}"/>
                <ComboBox x:Name="cbPet" DisplayMemberPath="Display" ToolTip="Животные, которые ещё находятся в приюте"/>

                <Label Content="ФИО нового владельца" Style="{DynamicResource FormLabel}"/>
                <TextBox x:Name="tbOwner" local:Input.Mode="Letters" MaxLength="80" ToolTip="Цифры вводить нельзя"/>

                <Label Content="Номер телефона" Style="{DynamicResource FormLabel}"/>
                <TextBox x:Name="tbPhone" local:Input.Mode="Phone" MaxLength="16" ToolTip="Только цифры и знак «-»"/>

                <CheckBox x:Name="chContract" Margin="0,6,0,12" TextBlock.FontSize="13"
                          ToolTip="Без подписанного договора выдача невозможна">
                    <TextBlock TextWrapping="Wrap" Text="Договор подписан: владелец обязуется гуманно обращаться с животным"/>
                </CheckBox>

                <Button Style="{StaticResource ConfirmButton}" Content="Оформить выдачу" Click="btnAdopt_Click"/>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
