<Window x:Class="AppliedProgramming.PetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AppliedProgramming"
        Style="{DynamicResource AppWindow}"
        Title="Питомцы приюта" Width="1000" Height="600" MinWidth="800" MinHeight="450"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Питомцы приюта" Style="{StaticResource Title}" VerticalAlignment="Center"/>
            <local:UserBar x:Name="userBar" HorizontalAlignment="Right"/>
        </Grid>

        <Button DockPanel.Dock="Bottom" Content="Назад" HorizontalAlignment="Left" Margin="0,10,0,0"
                Click="btnBack_Click" ToolTip="Shift + 1"/>

        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Label Content="Вид животного" Style="{DynamicResource FormLabel}"/>
                    <ComboBox x:Name="cbKind" SelectionChanged="Filter_Changed" ToolTip="Фильтр по виду животного"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <Label Content="Порода" Style="{DynamicResource FormLabel}"/>
                    <ComboBox x:Name="cbBreed" SelectionChanged="Filter_Changed" ToolTip="Фильтр по породе"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <Label Content="Пол" Style="{DynamicResource FormLabel}"/>
                    <ComboBox x:Name="cbGender" SelectionChanged="Filter_Changed" ToolTip="Фильтр по полу"/>
                </StackPanel>
                <Button Grid.Column="3" Content="Сбросить" VerticalAlignment="Bottom" Margin="4,4,4,8" Click="btnReset_Click"/>
            </Grid>
        </Border>

        <DataGrid x:Name="dgPets">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="50"/>
                <DataGridTextColumn Header="Кличка" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Вид" Binding="{Binding Kind}" Width="*"/>
                <DataGridTextColumn Header="Порода" Binding="{Binding Breed}" Width="*"/>
                <DataGridTextColumn Header="Возраст, лет" Binding="{Binding Age, StringFormat=0.#}" Width="100"/>
                <DataGridTextColumn Header="Вес, кг" Binding="{Binding Weight, StringFormat=0.#}" Width="80"/>
                <DataGridTextColumn Header="Пол" Binding="{Binding Gender}" Width="80"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
