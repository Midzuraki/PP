<Window x:Class="AppliedProgramming.RequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AppliedProgramming"
        Style="{DynamicResource AppWindow}"
        Title="Заявка клиента" Width="1000" Height="680" MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Заявка на сдачу / взятие животного" Style="{StaticResource Title}" VerticalAlignment="Center"/>
            <local:UserBar x:Name="userBar" HorizontalAlignment="Right"/>
        </Grid>
        <Button DockPanel.Dock="Bottom" Content="Назад" HorizontalAlignment="Left" Margin="0,10,0,0"
                Click="btnBack_Click" ToolTip="Shift + 1"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition x:Name="colRequests" Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Panel}" Margin="0,0,10,0">
                    <StackPanel>
                        <Label Content="ФИО клиента" Style="{DynamicResource FormLabel}"/>
                        <TextBox x:Name="tbClient" local:Input.Mode="Letters" MaxLength="80" ToolTip="Цифры вводить нельзя"/>

                        <Label Content="Номер телефона" Style="{DynamicResource FormLabel}"/>
                        <TextBox x:Name="tbPhone" local:Input.Mode="Phone" MaxLength="16" ToolTip="Только цифры и знак «-»"/>

                        <Label Content="Тип заявки" Style="{DynamicResource FormLabel}"/>
                        <ComboBox x:Name="cbType" SelectionChanged="cbType_SelectionChanged"/>

                        <StackPanel x:Name="spGive">
                            <Label Content="Кличка питомца" Style="{DynamicResource FormLabel}"/>
                            <TextBox x:Name="tbPetName" local:Input.Mode="Letters" MaxLength="30"/>
                            <Label Content="Вид животного" Style="{DynamicResource FormLabel}"/>
                            <ComboBox x:Name="cbKind"/>
                            <Label Content="Порода" Style="{DynamicResource FormLabel}"/>
                            <TextBox x:Name="tbBreed" local:Input.Mode="Letters" MaxLength="40"/>
                            <Label Content="Примерный возраст, лет" Style="{DynamicResource FormLabel}"/>
                            <TextBox x:Name="tbAge" local:Input.Mode="Decimal" MaxLength="5" ToolTip="Только цифры"/>
                        </StackPanel>

                        <StackPanel x:Name="spTake" Visibility="Collapsed">
                            <Label Content="Выберите питомца" Style="{DynamicResource FormLabel}"/>
                            <ComboBox x:Name="cbPet" DisplayMemberPath="Display"/>
                        </StackPanel>

                        <Label Content="Дата оформления" Style="{DynamicResource FormLabel}"/>
                        <TextBlock x:Name="tbDate" Margin="0,2,0,10"/>

                        <Button Content="Отправить заявку" Click="btnSend_Click"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="Поступившие заявки" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DataGrid x:Name="dgRequests">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="90"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="*"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="110"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding RequestType}" Width="*"/>
                        <DataGridTextColumn Header="Питомец" Binding="{Binding PetInfo}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
