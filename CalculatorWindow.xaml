<Window x:Class="AppliedProgramming.CalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="520" Width="340"
        MinHeight="420" MinWidth="280"
        WindowStartupLocation="CenterScreen"
        Background="#ababab">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#6e6b6c"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="102*"/>
            <RowDefinition Height="93*"/>
            <RowDefinition Height="93*"/>
            <RowDefinition Height="93*"/>
            <RowDefinition Height="93*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                Margin="4,4,4,4" Background="#dedede" CornerRadius="15" Padding="10,0" Grid.RowSpan="3">
            <TextBlock x:Name="tbDisplay" Text="0"
                       Foreground="#000000" FontSize="42"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <Button Grid.Row="3" Grid.Column="0" Content="7" Margin="4,4,4,4" Click="Button_Click_2" Background="#dedede" Foreground="#000000"/>
        <Button Grid.Row="3" Grid.Column="1" Content="8" Margin="4,4,4,4" Click="Button_Click_1" Background="#dedede" Foreground="#000000"/>
        <Button Grid.Row="3" Grid.Column="2" Content="9" Margin="4,4,4,4" Background="#dedede" Foreground="#000000"/>
        <Button Grid.Row="3" Grid.Column="3" Content="÷" Background="#6e6b6c" Margin="4,4,4,4"/>

        <Button Grid.Row="4" Grid.Column="0" Content="4" Margin="4,4,4,4" Background="#dedede" Foreground="#000000"/>
        <Button Grid.Row="4" Grid.Column="1" Content="5" Margin="4,4,4,4" Background="#dedede" Foreground="#000000"/>
        <Button Grid.Row="4" Grid.Column="2" Content="6" Margin="4,4,4,4" Background="#dedede" Foreground="#000000" Click="Button_Click_3"/>
        <Button Grid.Row="4" Grid.Column="3" Content="×" Background="#6e6b6c" Margin="4,4,4,4"/>

        <Button Grid.Row="5" Grid.Column="0" Content="1" Margin="4,4,4,4" Background="#dedede" Foreground="#000000"/>
        <Button Grid.Row="5" Grid.Column="1" Content="2" Margin="4,4,4,4" Background="#dedede" Foreground="#000000"/>
        <Button Grid.Row="5" Grid.Column="2" Content="3" Margin="4,4,4,4" Background="#dedede" Foreground="#000000"/>
        <Button Grid.Row="5" Grid.Column="3" Content="−" Background="#6e6b6c" Margin="4,4,4,4"/>

        <Button Grid.Row="6" Grid.Column="0" Content="0" Margin="4,4,4,4" Background="#dedede" Foreground="#000000"/>
        <Button Grid.Row="6" Grid.Column="1" Content="C" Margin="4,4,4,4" Background="#dedede" Foreground="#000000"/>
        <Button Grid.Row="6" Grid.Column="2" Content="=" Margin="4,4,4,4" Background="#dedede" Foreground="#000000"/>
        <Button Grid.Row="6" Grid.Column="3" Content="+" Background="#6e6b6c" Margin="4,4,4,4"/>
    </Grid>
</Window>
