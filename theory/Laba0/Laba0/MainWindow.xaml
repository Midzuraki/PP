<Window x:Class="Laba0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Laba0"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="820" MinHeight="450" MinWidth="820">
    <Window.Resources>
        <ResourceDictionary Source="ItemCards.xaml"></ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource Back}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <!--Основной-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="321*"></ColumnDefinition>
            <ColumnDefinition Width="159*"/>
            <ColumnDefinition Width="40*"></ColumnDefinition>
            <ColumnDefinition Width="280*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.35*"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Column="0" Height="113" VerticalAlignment="Top" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="480">
            <!--Верх, лево-->
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Text="Cupcake" Margin="50,10,361,35" FontFamily="Monotype Corsiva" FontSize="22" Foreground="White"></TextBlock>
            <Image Source="/logo.png" Margin="5,5,0,0" HorizontalAlignment="Left" Width="42" Height="40" VerticalAlignment="Top" />
            <ListBox Margin="5,0,0,0" Background="Transparent" BorderThickness="0" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="465">
                <ListBoxItem>
                    <Button Height="17" Width="52" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="Всё" FontFamily="Monotype Corsiva" FontSize="15" Width="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"></TextBlock>
                    </Button>
                </ListBoxItem>
                <ListBoxItem>
                    <Button Height="17" Width="52" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="Торты" FontFamily="Monotype Corsiva" FontSize="15" Width="50" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"></TextBlock>
                    </Button>
                </ListBoxItem>
                <ListBoxItem>
                    <Button Height="17" Width="52" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="Зефир" FontFamily="Monotype Corsiva" FontSize="15" Width="36" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"></TextBlock>
                    </Button>
                </ListBoxItem>
                <ListBoxItem>
                    <Button Height="17" Width="52" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="Шоколад" FontFamily="Monotype Corsiva" FontSize="15" Width="54" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"></TextBlock>
                    </Button>
                </ListBoxItem>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ></WrapPanel>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <Image Source="/search.png" Height="28" VerticalAlignment="Top" HorizontalAlignment="Left" Width="36" Margin="0,75,0,0" Grid.RowSpan="2" />
            <!--dobavit potom-->
            <TextBox Margin="30,73,0,0" Background="Transparent" Text="" BorderThickness="0" Foreground="White" FontSize="19" Height="28" VerticalAlignment="Top" HorizontalAlignment="Left" Width="450" Grid.RowSpan="2"/>
            <Border Grid.Row="1" Background="White" Margin="30,24,0,0" CornerRadius="2" Height="2" VerticalAlignment="Top"></Border>
            <!--это отвратительно-->
        </Grid>
        <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="0.2*"></RowDefinition>
            </Grid.RowDefinitions>
            <Border Grid.Column="0" Grid.Row="0" Margin="10,10,0,10" CornerRadius="8" BorderThickness="8" Background="#FFFFCCCC" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                <ListBox x:Name="buyout" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Width="294" VerticalAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="272" Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding Path=imgBuyout}" Stretch="Uniform" Margin="-40,0,0,0"></Image>
                                <TextBlock Text="{Binding Path=nameBuyout}" Grid.Column="1" FontFamily="Monotype Corsiva" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="8" Foreground="Black"></TextBlock>
                                <TextBlock Text="{Binding Path=priceBuyout}" Grid.Column="1" Margin="0,0,52,0" FontFamily="Monotype Corsiva" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="8" Foreground="Black"></TextBlock>
                                <TextBlock Text="руб. за " Grid.Column="1" Margin="40,0,0,0" FontFamily="Monotype Corsiva" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="8" Foreground="Black"></TextBlock>
                                <TextBlock Text="{Binding Path=weightBuyout}" Grid.Column="1" Margin="61,0,0,0" FontFamily="Monotype Corsiva" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="8" Foreground="Black"></TextBlock>
                                <Button Content="+" Background="Transparent" Grid.Column="3" Margin="10, 5, 60, 5"></Button>
                                <Button Content="-" Background="Transparent" Grid.Column="3" Margin="60, 5, 10, 5"></Button>
                                <TextBlock Text="{Binding Path=selectedBuyout}" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"></TextBlock>
                                <Border Background="{StaticResource Back}" CornerRadius="2" Margin="0,28,-180,0"></Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Vertical"></WrapPanel>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>
            <Button Grid.Row="1" Margin="0,0,20,0" BorderThickness="0.5" BorderBrush="White" Background="Transparent" Height="34" VerticalAlignment="Center" HorizontalAlignment="Right" Width="100">
                <TextBlock Text="Доставка" FontFamily="Monotype Corsiva" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"></TextBlock>
            </Button>
            <Button Grid.Row="1" Margin="0,0,130,0" BorderThickness="0.5" BorderBrush="White" Background="Transparent" Height="34" VerticalAlignment="Center" HorizontalAlignment="Right" Width="100">
                <TextBlock Text="Оформление заказа" TextWrapping="Wrap" TextAlignment="Center" FontFamily="Monotype Corsiva" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"></TextBlock>
            </Button>
            <TextBlock Grid.Row="1" Text="Lorem ipsum" Margin="0,0,251,0" FontFamily="Monotype Corsiva" FontSize="15" VerticalAlignment="Center" Foreground="White" HorizontalAlignment="Right" Width="68"/>
        </Grid>
        <Button Grid.Column="3" Grid.Row="0" Margin="0,10,14,0" BorderThickness="0.5" BorderBrush="White" Background="Transparent" HorizontalAlignment="Right" Width="88" Height="31" VerticalAlignment="Top">
            <TextBlock Text="Отчёты" FontFamily="Monotype Corsiva" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"></TextBlock>
        </Button>
        <ListBox x:Name="catalogList" Grid.Row="1" Background="Transparent" Margin="10,20,32,10" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" Grid.ColumnSpan="3" VerticalAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" BorderBrush="White" BorderThickness="10" Grid.Column="0" Grid.Row="1" Width="140" Height="175" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition Height="1.5*"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="{Binding Path=img}" Stretch="Uniform" ></Image>
                            <TextBlock Text="{Binding Path=name}" Grid.Row="1" FontFamily="Monotype Corsiva" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Back}" FontWeight="Bold"></TextBlock>
                            <TextBlock Text="{Binding Path=description}" Grid.Row="2" FontFamily="Monotype Corsiva" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" Foreground="Black"></TextBlock>
                            <TextBlock Text="{Binding Path=cal}" Grid.Row="3" Margin="0,0,73,10" FontFamily="Monotype Corsiva" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="8" Foreground="Black"></TextBlock>
                            <TextBlock Text="Ккал / 100 гр." Grid.Row="3" Margin="48,0,0,10" FontFamily="Monotype Corsiva" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="8" Foreground="Black"></TextBlock>
                            <TextBlock Text="{Binding Path=price}" Grid.Row="4" Margin="0,-30,73,10" FontFamily="Monotype Corsiva" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource Back}"></TextBlock>
                            <TextBlock Text="руб. за " Grid.Row="4" Margin="48,-30,0,10" FontFamily="Monotype Corsiva" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="8" Foreground="Black"></TextBlock>
                            <TextBlock Text="{Binding Path=weight}" Grid.Row="4" Margin="69,-30,0,10" FontFamily="Monotype Corsiva" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="8" Foreground="Black"></TextBlock>
                            <Image Grid.Row="4" Source="/stock.png" Stretch="Uniform" Margin="-39,5,49,5" ></Image>
                            <!--Картинка стока-->
                            <TextBlock Text="{Binding Path=stock}" Grid.Row="4" Margin="30,0,0,0" FontFamily="Monotype Corsiva" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="8" Foreground="Black"></TextBlock>
                            <Button Grid.Row="4" Margin="85 5 0 0" BorderThickness="0" Background="Transparent">
                                <Border Background="{StaticResource Back}" Height="28" Width="28" CornerRadius="20">
                                    <TextBlock Text="+" HorizontalAlignment="Center" Foreground="white" FontSize="18"/>
                                </Border>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" Orientation="Horizontal"></WrapPanel>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Window>
