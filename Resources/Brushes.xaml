<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ПР №8: словарь ресурсов с кистями. Подключён в App.xaml -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF2F6BFF" Offset="0"/>
        <GradientStop Color="#FF9B51E0" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WarmGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF8A00" Offset="0"/>
        <GradientStop Color="#FFE52E71" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="GlowBrush">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FF6FA8FF" Offset="1"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="SuccessBrush" Color="#FF2E9E5B"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFD64545"/>
</ResourceDictionary>
