<Window x:Class="AppliedProgramming.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource AppWindow}"
        Title="МДК 01.02 Прикладное программирование" Height="640" Width="420"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Практические работы" Style="{StaticResource Title}"
                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
        <Button x:Name="btnTheme" DockPanel.Dock="Bottom" Margin="4,10,4,0" Click="btnTheme_Click"
                ToolTip="Переключение темы всего приложения"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <Button Content="ПР №1. Калькулятор" Tag="1" Click="Pr_Click" ToolTip="Калькулятор на XAML и C#"/>
            <Button Content="ПР №2. Простая компоновка" Tag="2" Click="Pr_Click" ToolTip="Макет «Оплата картой» (Grid, StackPanel)"/>
            <Button Content="ПР №3. Сложная компоновка" Tag="3" Click="Pr_Click" ToolTip="Макеты окон по вариантам"/>
            <Button Content="ПР №4. Интерфейс системы" Tag="4" Click="Pr_Click" ToolTip="Все окна системы «В добрые руки», панель инструментов"/>
            <Button Content="ПР №5. Переходы между окнами" Tag="5" Click="Pr_Click" ToolTip="Авторизация, переходы, передача логина/пароля, кнопки «Назад»"/>
            <Button Content="ПР №6. События мыши и фокуса" Tag="6" Click="Pr_Click" ToolTip="3 попытки входа и блокировка на 30 с, подсказки, список «Выход»"/>
            <Button Content="ПР №7. События клавиатуры" Tag="7" Click="Pr_Click" ToolTip="Enter/Tab, запрет символов в полях, Shift + 1 = «Назад»"/>
            <Button Content="ПР №8. Ресурсы" Tag="8" Click="Pr_Click" ToolTip="Словарь кистей, ресурсы окна, градиент в заголовке окна входа"/>
            <Button Content="ПР №9. Стили" Tag="9" Click="Pr_Click" ToolTip="Единые стили, EventSetter, стиль, созданный в C#"/>
            <Button Content="ПР №10. Триггеры" Tag="10" Click="Pr_Click" ToolTip="Роли (DataTrigger), фокус полей, мультитриггер, наведение на кнопки"/>
            <Button Content="ПР №11. Темы приложения" Tag="11" Click="Pr_Click" ToolTip="Переключение тем кнопкой: обычная → монохром → тёмная"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
