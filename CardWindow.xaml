<Window x:Class="AppliedProgramming.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оплата картой" Height="440" Width="400"
        MinHeight="380" MinWidth="340"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Window.Resources>
        <!-- Подписи полей карты -->
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#FFD9DCE1"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!-- Значения полей карты -->
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- Вкладки сверху -->
        <Style x:Key="TabText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF9AB6F5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <!-- Ссылки Back / Pay -->
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#FF2F6BFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Главная сетка окна: вкладки / карта / кнопки -->
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Строка 0: вкладки ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.7*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Offers" Style="{StaticResource TabText}"/>

            <!-- Активная вкладка: текст + синее подчёркивание -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Credit/Debit" FontSize="14" FontWeight="SemiBold"
                           Foreground="#FF1B1F27" HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <Border Height="2" Background="#FF2F6BFF"/>
            </StackPanel>

            <TextBlock Grid.Column="2" Text="QuickPay" Style="{StaticResource TabText}"/>
            <TextBlock Grid.Column="3" Text="Net" Style="{StaticResource TabText}"/>
        </Grid>

        <!-- ===== Строка 1: карта ===== -->
        <Border Grid.Row="1" CornerRadius="10" Padding="18,14"
                VerticalAlignment="Center" Height="230">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF7A7F88" Offset="0"/>
                    <GradientStop Color="#FF5A5E66" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <!-- Внутренняя сетка карты: 4 строки -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Логотип VISA справа сверху -->
                <TextBlock Grid.Row="0" Text="VISA" FontSize="22" FontWeight="Bold"
                           FontStyle="Italic" Foreground="White"
                           HorizontalAlignment="Right"/>

                <!-- Номер карты -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="CARD NUMBER" Style="{StaticResource CardLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="****" Style="{StaticResource CardValue}"/>
                        <TextBlock Grid.Column="1" Text="****" Style="{StaticResource CardValue}"/>
                        <TextBlock Grid.Column="2" Text="****" Style="{StaticResource CardValue}"/>
                        <TextBlock Grid.Column="3" Text="0006" Style="{StaticResource CardValue}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="#66FFFFFF" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Владелец карты -->
                <StackPanel Grid.Row="2" Margin="0,4,0,0">
                    <TextBlock Text="CARD HOLDER" Style="{StaticResource CardLabel}"/>
                    <TextBlock Text="NOOH SAYED" Style="{StaticResource CardValue}"/>
                    <Border Height="1" Background="#66FFFFFF" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Срок действия и CVV -->
                <Grid Grid.Row="3" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="EXPIRES" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="12/28" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="CVV" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="***" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== Строка 2: Back / Pay ===== -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <TextBlock Text="←" Style="{StaticResource NavText}" Margin="0,0,8,0"/>
                <TextBlock Text="Back" Style="{StaticResource NavText}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock Text="Pay" Style="{StaticResource NavText}"/>
                <TextBlock Text="→" Style="{StaticResource NavText}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
